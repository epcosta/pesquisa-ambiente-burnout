generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  
}

model Instituicoes {
  id Int @id @default(autoincrement())
  ds_instituicao String? @db.VarChar(150)
  razao_social String @db.VarChar(150)
  nome_fantasia String? @db.VarChar(120)
  cnpj String? @db.Char(14)
  logradouro String? @db.VarChar(150)
  nro String? @db.VarChar(20)
  complemento String? @db.VarChar(100)
  bairro String? @db.VarChar(100)
  cidade String? @db.VarChar(100)
  uf String? @db.VarChar(2)
  cep String? @db.VarChar(10)
  nro_funcionarios Int?
  dt_alteracao DateTime? @db.Date
  dt_cadastro DateTime? @db.Date  
  pesquisas PesquisaAmbienteBurnout[]
  @@map("instituicoes")
}

model PesquisaAmbienteBurnout {
  id Int @id @default(autoincrement())
  dt_cadastro_pesquisa DateTime? @db.Date
  nm_responsavel String? @db.VarChar(80)
  email_responsavel String? @db.VarChar(100)
  ddd_responsavel String? @db.Char(2)
  fone_responsavel String? @db.VarChar(20)
  cargo_responsavel String? @db.VarChar(50)
  nro_funcionarios Int?
  dt_inicio_pesquisa DateTime? @db.Date
  dt_fechamento_pesquisa DateTime? @db.Date
  fechado String? @db.Char(1)
  nome_arte String? @db.VarChar(200)
  nome_arte_original String? @db.VarChar(200)
  id_area_instituicao Int?
  id_instituicoes Int
  instituicao Instituicoes @relation(fields:[id_instituicoes], references:[id])
  questionarios QuestionarioAmbienteBurnout[]
  @@index([id_instituicoes])
  @@map("pesquisa_ambiente_burnout")
}

