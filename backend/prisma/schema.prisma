model DimensaoAmbiente {
 id Int @id @default(autoincrement())
 ds_dimensao String? @db.VarChar(80)
 perguntas PesquisaAmbienteDimensao[]
 @@map("dimensoes_ambiente")
}
model PesquisaAmbienteDimensao {
 id Int @id @default(autoincrement())
 pergunta String? @db.VarChar(20)
 id_dimensoes_ambiente Int
 dimensao DimensaoAmbiente @relation(fields:[id_dimensoes_ambiente], references:[id])
 @@index([id_dimensoes_ambiente])
 @@map("pesquisa_ambiente_dimensoes")
}
model DimensaoBurnout {
 id Int @id @default(autoincrement())
 ds_dimensao String? @db.VarChar(45)
 perguntas PesquisaBurnoutDimensao[]
 @@map("dimensoes_burnout")
}
model PesquisaBurnoutDimensao {
 id Int @id @default(autoincrement())
 pergunta String? @db.VarChar(20)
 id_dimensoes_burnout Int
 dimensao DimensaoBurnout @relation(fields:[id_dimensoes_burnout], references:[id])
 @@index([id_dimensoes_burnout])
 @@map("pesquisa_burnout_dimensoes")
}
model TabelaDDD {
  id Int @id @default(autoincrement())
  ddd String @db.VarChar(3)
  @@map("tabela_ddd")
}
